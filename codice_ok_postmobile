    if(!cCity||!cReg) throw new Error('cities CSV: columns City/Region not found');
    cityRows.forEach(function(row){
      if(!row[cCity]) return;
      pdbAddCity(row[cCity], row[cReg], cSub?row[cSub]:'', cMore?row[cMore]:'');
    });
  }
  if(magRows.length){
    var m0=magRows[0];
